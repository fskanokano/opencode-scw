# ============================================================
# opencode-scw 只需要两个环境变量（其余全部有默认值）：
# 复制本文件为 .env（本地联调用）；Vercel 部署则在
# dash.vercel.com → Project → Settings → Environment Variables 配置同名字段。
# ============================================================

# 1) opencode Zen 的 API Key
#    在 https://opencode.ai 登录后创建 Zen 并复制 API Key。
#    opencode 原生认这个变量名；适配层也会据此写入它的 auth.json。
OPENCODE_API_KEY=

# 2) 你这个代理函数的访问密钥
#    任何调用方都必须带：  Authorization: Bearer <PROXY_API_KEY>
PROXY_API_KEY=

# ------- 可选（一般不用动） -------
# OPENCODE_SERVER_PASSWORD=                # 仅 Node 常驻形态：opencode server 的 Basic 密码（原生接口 / web UI 用）
#                                          # 缺省回退 PROXY_API_KEY —— "一把钥匙开两道门"
# OPENCODE_DEFAULT_MODEL=gpt-5.6-luna      # 客户端没传 model 时的默认模型
# OPENCODE_SDK_HOST=127.0.0.1              # 共享 opencode server 监听地址
# OPENCODE_SDK_PORT=0                      # 0 = 自动选空闲端口；也可固定端口
# OPENCODE_SDK_STARTUP_TIMEOUT_MS=60000    # 等待 opencode server 就绪的超时
# OPENCODE_DATA_HOME=                      # opencode 数据目录（默认临时目录）
# OPENCODE_AUTO_APPROVE=true               # 自动放行 agent 工具权限（false 关闭，默认开启）
# OPENCODE_STREAM_SMOOTHING=true            # 流式打字机平滑（大块 delta 切成小块推送；false 关闭，默认开启）
# OPENCODE_STREAM_CHUNK=8                    # 每块推送字符数（默认 8，越小越细腻）
# OPENCODE_STREAM_DELAY_MS=45               # 块间隔毫秒（默认 45，≈178 字符/秒）